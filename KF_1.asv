% ============================================================
% SCALAR KALMAN FILTER EXAMPLE
% Estimating the constant weight of an object based on measurements 

clear;
clc;
close all;

%% 1. Define the example

% True weight. This is known only because this is a simulation.
x_true = 10;                    % [kg]

% Three measured weights.
z = [8, 12, 9];                % [kg]

% Measurement variances.
% A smaller value means a more reliable measurement.
R = [4, 1, 4];                 % [kg^2]

% Process-noise variance.
% Q = 0 because the true weight is assumed to remain constant.
Q = 0;                         % [kg^2]

N_measurements = numel(z);
disp (N_measurements)

% Storage for results.
x_est     = zeros(1, N_measurements);
P_est     = zeros(1, N_measurements);

%% 2. Initialise the Kalman filter

% initialise the Kalman filter using the first independent measurement.
%   x = first measured weight
%   P = variance of the first measurement

x = z(1);                      % Initial weight estimate [kg]
P = R(1);                      % Initial estimate variance [kg^2]

% Store the first estimate 

x_est(1) = x;
P_est(1) = P;

fprintf('\nInitialisation using measurement 1: \n');
fprintf('z(1) = %.2f kg\n', z(1));
fprintf('R(1) = %.2f kg^2\n', R(1));
fprintf('Initial estimate x = %.2f kg\n', x);
fprintf('Initial uncertainty P = %.2f kg^2\n', P);

%% 3. Storage for intermediate Kalman diagnostics

x_pred_all   = nan(1, N_measurements);
P_pred_all   = nan(1, N_measurements);
K_all        = nan(1, N_measurements);
residual_all = nan(1, N_measurements);

% No prediction or Kalman update is performed for measurement 1
% because it was used to initialise the filter

%% ------------------------------------------------------------
% 4. Kalman prediction and measurement update
% ------------------------------------------------------------

for k = 2:N_measurements

    fprintf('\n----------------------------------------\n');
    fprintf('Processing measurement %d\n', k);
    fprintf('----------------------------------------\n');

    % STEP 1: PREDICTION
    
    % Constant-state model:
    %
    %   x_pred = x
    %
    % The estimated weight is carried forward because the
    % object's true weight is assumed to remain constant.

    x_pred = x;

    % Predicted uncertainty:
    %
    %   P_pred = P + Q
    %
    % Q represents possible changes in the real weight.
    % Here Q = 0 because the weight is assumed constant.

    P_pred = P + Q;

    % =========================================================
    % STEP 2: KALMAN GAIN
    % =========================================================

    % The Kalman gain determines how strongly the estimate
    % should respond to the new measurement.
    %
    %   K = P_pred / (P_pred + R)
    %
    % Large P_pred:
    %   Low confidence in prediction -> trust measurement more.
    %
    % Large R:
    %   Low confidence in measurement -> trust prediction more.

    K = P_pred / (P_pred + R(k));


    % =========================================================
    % STEP 3: MEASUREMENT RESIDUAL
    % =========================================================

    % The residual, or innovation, is the difference between
    % the new measurement and the predicted estimate.
    %
    %   residual = measurement - prediction

    residual = z(k) - x_pred;


    % =========================================================
    % STEP 4: STATE UPDATE
    % =========================================================

    % Correct the prediction using a fraction K of the residual.
    %
    %   x = x_pred + K * residual

    x = x_pred + K * residual;


    % =========================================================
    % STEP 5: UNCERTAINTY UPDATE
    % =========================================================

    % After combining the prediction with the measurement,
    % the uncertainty normally decreases.
    %
    % Scalar covariance-update equation:
    %
    %   P = (1 - K) * P_pred

    P = (1 - K) * P_pred;


    % =========================================================
    % STEP 6: STORE RESULTS
    % =========================================================

    x_pred_all(k)   = x_pred;
    P_pred_all(k)   = P_pred;
    K_all(k)        = K;
    residual_all(k) = residual;

    x_est(k) = x;
    P_est(k) = P;


    % =========================================================
    % STEP 7: DISPLAY RESULTS
    % =========================================================

    fprintf('Measurement z       = %.4f kg\n', z(k));
    fprintf('Measurement R       = %.4f kg^2\n', R(k));
    fprintf('Predicted estimate  = %.4f kg\n', x_pred);
    fprintf('Predicted variance  = %.4f kg^2\n', P_pred);
    fprintf('Kalman gain         = %.4f\n', K);
    fprintf('Residual             = %.4f kg\n', residual);
    fprintf('Updated estimate    = %.4f kg\n', x);
    fprintf('Updated variance    = %.4f kg^2\n', P);

end














