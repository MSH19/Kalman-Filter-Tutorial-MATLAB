% ============================================================
% 2D KALMAN FILTER EXAMPLE
% Estimating the constant 2D position of an object
% ============================================================

clear;
clc;
close all;

%% ------------------------------------------------------------
% 1. Define the true state
% ------------------------------------------------------------

% The object is located at:
%
%   x-position = 10 m
%   y-position = 5 m
%
% These two values are placed inside one state vector.

x_true = [10; 5];                 % [m]

disp('True state vector:');
disp(x_true);

%% ------------------------------------------------------------
% 2. Define the position measurements

% Each COLUMN contains one 2D position measurement.
%
%             Measurement:
%                 1      2      3      4      5
%
% x-position:    8.0   11.0    9.5   10.2   13.0
% y-position:    6.0    4.5    5.8    5.1    7.0

z = [8.0, 11.0, 9.5, 10.2, 13.0;
     6.0,  4.5, 5.8,  5.1,  7.0];       % [m]

% Number of measurements.
N_measurements = size(z, 2);

disp('Position measurements:');
disp(z);

fprintf('Number of measurements: %d\n', N_measurements);

%% ------------------------------------------------------------
% 3. Define measurement covariance matrices
% ------------------------------------------------------------

% Each measurement has a 2 x 2 covariance matrix:
%
%           [variance of x      covariance of x and y]
%   R(k) =  [                                         ]
%           [covariance of y and x      variance of y]
%
% For now, all off-diagonal elements are zero.
% Therefore, the x and y measurement errors are assumed
% to be uncorrelated.

R_all = cell(N_measurements, 1);

% Measurement 1:
% x variance = 4 m^2
% y variance = 1 m^2
R_all{1} = [4, 0;
            0, 1];

% Measurement 2:
% x variance = 1 m^2
% y variance = 4 m^2
R_all{2} = [1, 0;
            0, 4];

% Measurement 3:
% Equal moderate uncertainty in x and y.
R_all{3} = [2.25, 0;
            0, 2.25];

% Measurement 4:
% Very reliable measurement in both coordinates.
R_all{4} = [0.25, 0;
            0, 0.25];

% Measurement 5:
% Unreliable measurement in both coordinates.
R_all{5} = [9, 0;
            0, 9];

disp('Covariance matrix of measurement 1:');
disp(R_all{1});



